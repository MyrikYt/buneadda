function startGame(){
  const room=S.rooms[S.currentRoom];
  if(!room||room.host!==S.me) return;
  if(room.players.length<2) return toast('Нужно хотя бы 2 игрока','error');
  room.status='playing';
  room.phase='game';
  room.roundInfo='Знакомство';
  addSystemMsg(room,'Игра началась! Представьте свои карточки 🎮');
  saveRooms();
  document.getElementById('pb_revealAll').style.display='';
  document.getElementById('phaseBannerText').innerHTML='<strong>Знакомство</strong> — каждый игрок представляет свою карточку';
}

function revealField(key){
  const room=S.rooms[S.currentRoom];
  if(!room) return;
  if(!room.revealedFields[S.me]) room.revealedFields[S.me]=[];
  if(!room.revealedFields[S.me].includes(key)){
    room.revealedFields[S.me].push(key);
    saveRooms();
    const card=room.cards[S.me];
    const val=key==='age'?card[key]+' лет':card[key];
    addSystemMsg(room,`${S.me} раскрыл: ${key==='profession'?'Профессия':key==='hobby'?'Хобби':key==='health'?'Здоровье':key==='trait'?'Характер':key==='phobia'?'Фобия':key==='extra'?'Способность':key==='age'?'Возраст':key==='size'?'Телосложение':'Пол'} — ${val}`);
  }
}

function revealAllMyCard(){
  const room=S.rooms[S.currentRoom];
  const keys=['gender','age','size','profession','hobby','health','trait','phobia','extra'];
  if(!room.revealedFields[S.me]) room.revealedFields[S.me]=[];
  keys.forEach(k=>{ if(!room.revealedFields[S.me].includes(k)) room.revealedFields[S.me].push(k); });
  saveRooms();
  addSystemMsg(room,`${S.me} раскрыл всю карточку!`);
}

function kickPlayer(player){
  const room=S.rooms[S.currentRoom];
  if(!room||room.host!==S.me) return;
  if(!confirm(`Выгнать ${player} из бункера?`)) return;
  room.kicked=room.kicked||[];
  room.kicked.push(player);
  room.players=room.players.filter(p=>p!==player);
  addSystemMsg(room,`⚠️ ${player} выгнан из бункера! Голоса: -`);
  // Check win
  const alive=room.players.filter(p=>!room.kicked.includes(p));
  const needed=Math.floor(room.maxPlayers/2);
  if(alive.length<=needed){
    room.status='finished';
    room.survivors=alive;
    addSystemMsg(room,`🏆 Игра окончена! Выжившие: ${alive.join(', ')}`);
  }
  saveRooms();
  toast(`${player} выгнан!`,'info');
}

function addSystemMsg(room,text){
  if(!room.chat) room.chat=[];
  const now=new Date();
  room.chat.push({system:true,text,time:`${now.getHours()}:${String(now.getMinutes()).padStart(2,'0')}`});
  if(room.chat.length>200) room.chat=room.chat.slice(-200);
}

function sendChat(){
  const input=document.getElementById('chatInput');
  const text=input.value.trim();
  if(!text) return;
  const room=S.rooms[S.currentRoom];
  if(!room) return;
  if(!room.chat) room.chat=[];
  const now=new Date();
  room.chat.push({author:S.me,text,time:`${now.getHours()}:${String(now.getMinutes()).padStart(2,'0')}`});
  if(room.chat.length>200) room.chat=room.chat.slice(-200);
  saveRooms();
  input.value='';
  renderChat(room);
}

// ════════════════════════════════════════════════
// VOTE
// ════════════════════════════════════════════════
function openVote(){
  const room=S.rooms[S.currentRoom];
  if(!room) return;
  if(room.status!=='playing') return toast('Игра ещё не начата','error');
  room.phase='vote';
  room.votes=room.votes||{};
  S.myVote=null;
  saveRooms();
  document.getElementById('voteOverlay').classList.add('open');
  document.getElementById('voteResults').style.display='none';
  renderVotePanel(room);
}

function closeVote(){ document.getElementById('voteOverlay').classList.remove('open'); }

function renderVotePanel(room){
  const alivePlayers=room.players.filter(p=>!(room.kicked||[]).includes(p));
  const voteList=document.getElementById('voteList');
  const totalVotes=Object.keys(room.votes||{}).length;
  const voteCounts={};
  Object.values(room.votes||{}).forEach(v=>{voteCounts[v]=(voteCounts[v]||0)+1;});
  voteList.innerHTML=alivePlayers.filter(p=>p!==S.me).map(p=>{
    const vc=voteCounts[p]||0;
    const pct=totalVotes?Math.round(vc/totalVotes*100):0;
    return `<div class="vote-player ${S.myVote===p?'selected':''}" onclick="selectVote('${p}',this)">
      <div class="vp-bar" style="width:${pct}%"></div>
      <div style="width:30px;height:30px;border-radius:50%;background:${avColor(p)};display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.8rem;color:#fff;position:relative;">${avLetter(p)}</div>
      <div class="vp-name">${p}</div>
      <div class="vp-votes">${vc} голос${vc===1?'':'ов'}</div>
    </div>`;
  }).join('');
}

function selectVote(player,el){
  S.myVote=player;
  document.querySelectorAll('.vote-player').forEach(e=>e.classList.remove('selected'));
  el.classList.add('selected');
  document.getElementById('confirmVoteBtn').disabled=false;
}

function confirmVote(){
  if(!S.myVote) return;
  const room=S.rooms[S.currentRoom];
  room.votes=room.votes||{};
  room.votes[S.me]=S.myVote;
  saveRooms();
  document.getElementById('confirmVoteBtn').disabled=true;
  renderVotePanel(room);
  // Count votes
  const voteCounts={};
  Object.values(room.votes).forEach(v=>{voteCounts[v]=(voteCounts[v]||0)+1;});
  const totalVoters=room.players.filter(p=>!(room.kicked||[]).includes(p)).length;
  const voted=Object.keys(room.votes).length;
  // If all voted or host confirms
  if(room.host===S.me && voted>=totalVoters-1){
    // Find max
    const winner=Object.entries(voteCounts).sort((a,b)=>b[1]-a[1])[0];
    if(winner){
      showVoteResults(room,voteCounts);
    }
  } else {
    toast(`Ты проголосовал за ${S.myVote}`,'info');
  }
}

function showVoteResults(room,voteCounts){
  const sorted=Object.entries(voteCounts).sort((a,b)=>b[1]-a[1]);
  const losers=sorted.slice(0,1);
  document.getElementById('voteResults').style.display='block';
  document.getElementById('voteResultsList').innerHTML=sorted.map(([name,count])=>`
    <div class="vote-player" style="cursor:default;${losers[0][0]===name?'border-color:var(--red);background:rgba(239,68,68,.15)':''}">
      <div style="width:28px;height:28px;border-radius:50%;background:${avColor(name)};display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.8rem;color:#fff;">${avLetter(name)}</div>
      <div class="vp-name">${name}</div>
      <div class="vp-votes">${count} голос${count===1?'':'ов'}</div>
      ${losers[0][0]===name?'<span style="font-size:.75rem;color:var(--red);">🚪 Выгнан</span>':''}
    </div>
  `).join('');
  if(room.host===S.me && losers.length){
    setTimeout(()=>kickPlayer(losers[0][0]),1500);
  }
  toast(`Итоги: ${losers[0][0]} выгнан с ${losers[0][1]} голос${losers[0][1]===1?'ом':'ами'}`,'error',5000);
}

// ════════════════════════════════════════════════
// MEDIA (WebRTC local)
// ════════════════════════════════════════════════
async function requestMedia(){
  try {
    const stream=await navigator.mediaDevices.getUserMedia({video:true,audio:true});
    S.localStream=stream;
    S.micOn=true; S.camOn=true;
    updateMediaUI();
    // Attach to own video
    const vid=document.getElementById(`vid_${S.me}`);
    if(vid){ vid.srcObject=stream; vid.muted=true; }
    const nocam=document.getElementById(`nocam_${S.me}`);
    if(nocam) nocam.style.display='none';
    toast('Камера и микрофон подключены 🎥','success');
  } catch(e){
    try {
      const stream=await navigator.mediaDevices.getUserMedia({audio:true,video:false});
      S.localStream=stream; S.micOn=true; S.camOn=false;
      updateMediaUI();
      toast('Только микрофон (камера недоступна) 🎤','info');
    } catch(e2){
      S.micOn=false; S.camOn=false;
      updateMediaUI();
      toast('Нет доступа к камере/микрофону — продолжаем без медиа','info');
    }
  }
}

function stopMedia(){
  if(S.localStream){ S.localStream.getTracks().forEach(t=>t.stop()); S.localStream=null; }
  S.micOn=false; S.camOn=false;
}

function toggleMic(){
  if(!S.localStream){ requestMedia(); return; }
  const tracks=S.localStream.getAudioTracks();
  if(!tracks.length) return;
  S.micOn=!S.micOn;
  tracks.forEach(t=>t.enabled=S.micOn);
  updateMediaUI();
  toast(S.micOn?'Микрофон включён':'Микрофон выключен','info',1500);
}

function toggleCam(){
  if(!S.localStream){ requestMedia(); return; }
  const tracks=S.localStream.getVideoTracks();
  if(!tracks.length) return;
  S.camOn=!S.camOn;
  tracks.forEach(t=>t.enabled=S.camOn);
  updateMediaUI();
  const nocam=document.getElementById(`nocam_${S.me}`);
  if(nocam) nocam.style.display=S.camOn?'none':'flex';
  toast(S.camOn?'Камера включена':'Камера выключена','info',1500);
}

function updateMediaUI(){
  // Waiting screen buttons
  const wMic=document.getElementById('wv_micBtn');
  const wCam=document.getElementById('wv_camBtn');
  if(wMic){ wMic.textContent=S.micOn?'🎤 Мик вкл':'🔇 Мик выкл'; wMic.style.color=S.micOn?'':'var(--red)'; }
  if(wCam){ wCam.textContent=S.camOn?'📹 Кам вкл':'🚫 Кам выкл'; wCam.style.color=S.camOn?'':'var(--red)'; }
  // Play screen buttons
  const micBtn=document.getElementById('micBtn');
  const camBtn=document.getElementById('camBtn');
  if(micBtn){ micBtn.textContent=S.micOn?'🎤':'🔇'; micBtn.classList.toggle('active',!S.micOn); }
  if(camBtn){ camBtn.textContent=S.camOn?'📹':'🚫'; camBtn.classList.toggle('active',!S.camOn); }
}

// ════════════════════════════════════════════════
// UI TABS
// ════════════════════════════════════════════════
function switchRightTab(tab){
  ['card','chat','bunker'].forEach(t=>{
    document.getElementById(`rtab_${t}`).classList.toggle('active',t===tab);
    document.getElementById(`rpanel_${t}`).classList.toggle('active',t===tab);
  });
  if(tab==='bunker'){
    const room=S.rooms[S.currentRoom];
    if(room) renderBunkerInfo(room);
  }
}

function copyRoomCode(){
  const code=document.getElementById('wv_roomCode').textContent;
  navigator.clipboard.writeText(code).then(()=>toast('Код скопирован: '+code,'success',1500)).catch(()=>toast('Код: '+code,'info'));
}

