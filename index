// AUTH
// ════════════════════════════════════════════════
function authTab(tab){
  const isLogin = tab==='login';
  document.querySelectorAll('.atab').forEach((t,i)=>t.classList.toggle('active',(i===0&&isLogin)||(i===1&&!isLogin)));
  document.getElementById('loginForm').classList.toggle('hidden',!isLogin);
  document.getElementById('regForm').classList.toggle('hidden',isLogin);
  document.getElementById('authHint').innerHTML = isLogin
    ? '<span onclick="authTab(\'reg\')">Нет аккаунта? Зарегистрироваться</span>'
    : '<span onclick="authTab(\'login\')">Уже есть аккаунт? Войти</span>';
}

function doLogin(){
  const u=document.getElementById('li_user').value.trim();
  const p=document.getElementById('li_pass').value;
  if(!u||!p) return toast('Заполни все поля','error');
  if(!S.passes[u]||S.passes[u]!==p) return toast('Неверный логин или пароль','error');
  loginSuccess(u);
}

function doRegister(){
  const u=document.getElementById('rg_user').value.trim();
  const p=document.getElementById('rg_pass').value;
  const p2=document.getElementById('rg_pass2').value;
  if(!u||!p||!p2) return toast('Заполни все поля','error');
  if(u.length<2) return toast('Логин слишком короткий','error');
  if(p!==p2) return toast('Пароли не совпадают','error');
  if(S.passes[u]) return toast('Этот логин занят','error');
  S.passes[u]=p;
  localStorage.setItem('bk_passes',JSON.stringify(S.passes));
  toast('Аккаунт создан! 🎉','success');
  setTimeout(()=>loginSuccess(u),600);
}

function loginSuccess(name){
  S.me=name;
  document.getElementById('tbarAvatar').textContent=avLetter(name);
  document.getElementById('tbarAvatar').style.background=avColor(name);
  document.getElementById('tbarName').textContent=name;
  showScreen('lobbyScreen');
  cleanupRooms();
  renderRooms();
  toast(`Добро пожаловать, ${name}!`,'success');
}

function doLogout(){
  leaveCurrentRoom(true);
  S.me=null;
  showScreen('authScreen');
}

