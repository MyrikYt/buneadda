let prevPhase='';
function renderGameScreen(){
  const room=S.rooms[S.currentRoom];
  if(!room) return;

  // Topbar
  document.getElementById('gtb_roomName').textContent=room.name;
  document.getElementById('gtb_playerCount').textContent=`👤 ${room.players.length}/${room.maxPlayers}`;
  document.getElementById('gtb_roundInfo').textContent=room.roundInfo||'';

  const isHost=room.host===S.me;

  if(room.status==='waiting'){
    document.getElementById('gtb_phase').textContent='Ожидание';
    document.getElementById('gtb_phase').className='gtb-phase phase-lobby';
    document.getElementById('waitingView').style.display='flex';
    document.getElementById('playingView').style.display='none';
    document.getElementById('startGameBtn').style.display=isHost?'':'none';
    document.getElementById('wv_startBtn').style.display=isHost?'':'none';
    document.getElementById('voteStartBtn').style.display='none';
    renderWaiting(room);
  } else {
    document.getElementById('gtb_phase').textContent=room.phase==='vote'?'Голосование':'Игра';
    document.getElementById('gtb_phase').className=room.phase==='vote'?'gtb-phase phase-vote':'gtb-phase phase-game';
    document.getElementById('waitingView').style.display='none';
    document.getElementById('playingView').style.display='flex';
    document.getElementById('startGameBtn').style.display='none';
    document.getElementById('voteStartBtn').style.display=isHost?'':'none';
    renderPlaying(room);
  }
}

function renderWaiting(room){
  document.getElementById('wv_roomName').textContent=room.name;
  document.getElementById('wv_roomCode').textContent=room.id;
  const isHost=room.host===S.me;
  document.getElementById('wv_startBtn').style.display=isHost&&room.players.length>=2?'':'none';

  document.getElementById('wv_players').innerHTML=room.players.map(p=>`
    <div class="wp-card ${p===S.me?'me':''}">
      <div style="width:28px;height:28px;border-radius:50%;background:${avColor(p)};display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.8rem;color:#fff;">${avLetter(p)}</div>
      <span>${p}</span>
      ${p===room.host?'<span class="wp-host-icon">👑</span>':''}
    </div>
  `).join('');

  document.getElementById('wv_settings_preview').innerHTML=`
    🌍 ${room.catastrophe.substring(0,60)}...<br>
    🏚️ ${room.bunker.name} · ${room.preset==='hard'?'⚔️ Хардкор':room.preset==='fun'?'😄 Веселый':'📖 Классика'}
  `;
}

function renderPlaying(room){
  renderPlayersList(room);
  renderVideoGrid(room);
  renderCharCard(room);
  renderBunkerInfo(room);
  renderChat(room);
  if(room.phase==='vote' && document.getElementById('voteOverlay').classList.contains('open')){
    renderVotePanel(room);
  }
}

function renderPlayersList(room){
  const el=document.getElementById('playersListEl');
  el.innerHTML=room.players.map(p=>{
    const isKicked=room.kicked && room.kicked.includes(p);
    const isHost=p===room.host;
    return `<div class="player-row ${p===S.me?'me':''} ${isHost?'host-row':''} ${isKicked?'kicked':''}">
      <div class="pavatar" style="background:${avColor(p)};">${avLetter(p)}</div>
      <div class="pinfo">
        <div class="pname">${p}</div>
        <div class="pstatus">${isKicked?'Выгнан':p===S.me?'Это ты':'Онлайн'}</div>
      </div>
      ${room.host===S.me && p!==S.me && !isKicked
        ? `<button class="btn btn-danger btn-xs" onclick="kickPlayer('${p}')">✕</button>`:''}
    </div>`;
  }).join('');
}

function renderVideoGrid(room){
  const grid=document.getElementById('videoGrid');
  const total=room.players.length;
  grid.className=`video-grid count-${Math.min(total,8)}`;

  // Build tiles
  const existingIds=new Set([...grid.querySelectorAll('.video-tile')].map(t=>t.dataset.pid));
  const newIds=new Set(room.players);
  // Remove old
  grid.querySelectorAll('.video-tile').forEach(t=>{if(!newIds.has(t.dataset.pid))t.remove();});
  // Add new / update
  room.players.forEach(p=>{
    let tile=grid.querySelector(`[data-pid="${p}"]`);
    if(!tile){
      tile=document.createElement('div');
      tile.className=`video-tile ${p===S.me?'me-tile':''}`;
      tile.dataset.pid=p;
      tile.innerHTML=`
        <video id="vid_${p}" autoplay muted playsinline></video>
        <div class="no-cam" id="nocam_${p}">
          <div class="no-cam-av" style="background:${avColor(p)};">${avLetter(p)}</div>
          <div style="font-size:.75rem;color:var(--muted2);">${p}</div>
        </div>
        <div class="vtile-icons">
          <div class="vtile-icon" id="vicon_mic_${p}">🎤</div>
        </div>
        <div class="vtile-name">${p}${p===S.me?' (Я)':''}</div>
      `;
      grid.appendChild(tile);
    }
    // attach local stream
    if(p===S.me && S.localStream){
      const vid=document.getElementById(`vid_${p}`);
      if(vid && vid.srcObject!==S.localStream){vid.srcObject=S.localStream;}
      const hasVideo=S.localStream.getVideoTracks().some(t=>t.enabled && t.readyState==='live');
      const nocam=document.getElementById(`nocam_${p}`);
      if(nocam) nocam.style.display=hasVideo?'none':'flex';
    }
  });
}

function renderCharCard(room){
  const card=room.cards[S.me];
  if(!card){document.getElementById('charCardContainer').innerHTML='<div style="color:var(--muted);font-size:.85rem;text-align:center;padding:20px;">Карточка не найдена</div>';return;}
  const revealed=room.revealedFields[S.me]||[];
  const fields=[
    {key:'gender',label:'Пол'},
    {key:'age',label:'Возраст'},
    {key:'size',label:'Телосложение'},
    {key:'profession',label:'Профессия'},
    {key:'hobby',label:'Хобби'},
    {key:'health',label:'Здоровье'},
    {key:'trait',label:'Характер'},
    {key:'phobia',label:'Фобия'},
    {key:'extra',label:'Доп. способность'},
  ];
  document.getElementById('charCardContainer').innerHTML=`
    <div class="char-card">
      <div class="cc-header">
        <h4>🃏 Твоя карточка</h4>
        <span style="font-size:.7rem;color:var(--muted);">${revealed.length}/${fields.length} раскрыто</span>
      </div>
      <div class="cc-body">
        ${fields.map(f=>{
          const isRevealed=revealed.includes(f.key);
          return `<div class="cc-row">
            <div class="cc-key">${f.label}</div>
            <div class="cc-val ${isRevealed?'':'hidden-val'}">
              ${isRevealed
                ? `<span>${f.key==='age'?card[f.key]+' лет':card[f.key]}</span>`
                : `<span>Скрыто</span><button class="reveal-btn" onclick="revealField('${f.key}')">Раскрыть</button>`}
            </div>
          </div>`;
        }).join('')}
      </div>
    </div>
    <div style="margin-top:12px;display:flex;flex-direction:column;gap:8px;">
      ${room.cards && Object.keys(room.cards).filter(p=>p!==S.me).map(p=>{
        const oc=room.cards[p];
        const or=room.revealedFields[p]||[];
        if(or.length===0) return '';
        return `<div class="bunker-info-block">
          <div class="bib-title" style="display:flex;align-items:center;gap:6px;">
            <div style="width:16px;height:16px;border-radius:50%;background:${avColor(p)};display:inline-flex;align-items:center;justify-content:center;font-size:.6rem;font-weight:700;color:#fff;">${avLetter(p)}</div>
            ${p}
          </div>
          ${or.map(fk=>`<div style="font-size:.82rem;color:var(--muted2);margin-top:3px;"><span style="color:var(--muted);font-size:.72rem;">${fk==='profession'?'Профессия':fk==='hobby'?'Хобби':fk==='health'?'Здоровье':fk==='trait'?'Характер':fk==='phobia'?'Фобия':fk==='extra'?'Способность':fk==='age'?'Возраст':fk==='size'?'Телосложение':'Пол'}:</span> ${fk==='age'?oc[fk]+' лет':oc[fk]}</div>`).join('')}
        </div>`;
      }).join('')}
    </div>
  `;
}

