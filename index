<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🏚️ Бункер Онлайн</title>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300;400;600;700;900&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0e0f14;
  --bg2: #13141b;
  --bg3: #1a1b24;
  --card: #1e2030;
  --border: rgba(255,255,255,0.07);
  --border2: rgba(255,255,255,0.12);
  --accent: #e05c2a;
  --accent2: #f07840;
  --blue: #3b82f6;
  --green: #22c55e;
  --red: #ef4444;
  --yellow: #eab308;
  --purple: #a855f7;
  --text: #e8e9f0;
  --muted: #6b7280;
  --muted2: #9ca3af;
  --radius: 14px;
  --glow-accent: 0 0 30px rgba(224,92,42,0.25);
}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{height:100%;overflow:hidden;}
body{
  font-family:'Jost',sans-serif;
  background:var(--bg);
  color:var(--text);
  height:100vh;
  overflow:hidden;
}

/* ── SCROLLBAR ── */
::-webkit-scrollbar{width:5px;}
::-webkit-scrollbar-track{background:var(--bg2);}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.1);border-radius:3px;}

/* ── SCREENS ── */
.screen{display:none;width:100%;height:100vh;}
.screen.active{display:flex;}

/* ════════════════════════════════
   AUTH SCREEN
════════════════════════════════ */
#authScreen{
  align-items:center;justify-content:center;
  background:
    radial-gradient(ellipse 60% 50% at 20% 40%, rgba(224,92,42,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 50% 40% at 80% 70%, rgba(59,130,246,0.06) 0%, transparent 60%),
    var(--bg);
  flex-direction:column;
  gap:0;
}

.auth-logo-wrap{text-align:center;margin-bottom:40px;}
.auth-logo{
  font-family:'Unbounded',sans-serif;
  font-size:clamp(2.2rem,5vw,3.5rem);
  font-weight:900;
  background:linear-gradient(135deg,#ff6b35,#e05c2a,#c44b1a);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  filter:drop-shadow(0 0 40px rgba(224,92,42,0.5));
  letter-spacing:-1px;
}
.auth-tagline{
  color:var(--muted2);font-size:.85rem;
  letter-spacing:4px;text-transform:uppercase;
  margin-top:6px;font-weight:300;
}

.auth-box{
  background:var(--card);
  border:1px solid var(--border2);
  border-radius:20px;
  padding:36px 40px;
  width:min(420px,92vw);
  box-shadow:0 30px 80px rgba(0,0,0,0.6), var(--glow-accent);
  position:relative;overflow:hidden;
}
.auth-box::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,transparent,var(--accent),transparent);
}

.auth-tabs{
  display:flex;gap:4px;background:var(--bg2);
  border-radius:10px;padding:4px;margin-bottom:28px;
}
.atab{
  flex:1;padding:10px;border:none;background:transparent;
  color:var(--muted2);cursor:pointer;border-radius:8px;
  font-family:'Jost';font-size:.9rem;font-weight:500;
  letter-spacing:1px;text-transform:uppercase;transition:all .25s;
}
.atab.active{background:var(--accent);color:#fff;font-weight:600;}

.aform{display:flex;flex-direction:column;gap:14px;}
.aform.hidden{display:none;}

.field label{
  display:block;font-size:.75rem;letter-spacing:2px;
  text-transform:uppercase;color:var(--muted);margin-bottom:6px;
}
.field input{
  width:100%;padding:13px 16px;
  background:var(--bg2);border:1px solid var(--border2);
  border-radius:10px;color:var(--text);
  font-family:'Jost';font-size:1rem;outline:none;transition:all .2s;
}
.field input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(224,92,42,0.15);}

.btn{
  padding:13px 20px;border:none;border-radius:10px;
  cursor:pointer;font-family:'Jost';font-size:.95rem;
  font-weight:600;letter-spacing:1px;text-transform:uppercase;
  transition:all .25s;display:inline-flex;align-items:center;justify-content:center;gap:8px;
}
.btn-accent{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;}
.btn-accent:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(224,92,42,0.4);}
.btn-outline{background:transparent;border:1px solid var(--border2);color:var(--muted2);}
.btn-outline:hover{border-color:var(--accent);color:var(--accent);}
.btn-ghost{background:rgba(255,255,255,0.05);color:var(--text);}
.btn-ghost:hover{background:rgba(255,255,255,0.1);}
.btn-danger{background:rgba(239,68,68,0.15);color:var(--red);border:1px solid rgba(239,68,68,0.3);}
.btn-danger:hover{background:rgba(239,68,68,0.25);}
.btn-blue{background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;}
.btn-blue:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(59,130,246,0.4);}
.btn-green{background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;}
.btn-green:hover{transform:translateY(-2px);}
.btn-sm{padding:8px 14px;font-size:.8rem;}
.btn-xs{padding:5px 10px;font-size:.75rem;border-radius:7px;}
.btn:disabled{opacity:.4;cursor:not-allowed;transform:none!important;}

.auth-hint{text-align:center;margin-top:14px;font-size:.82rem;color:var(--muted);}
.auth-hint span{color:var(--accent);cursor:pointer;text-decoration:underline;}

/* ════════════════════════════════
   LOBBY
════════════════════════════════ */
#lobbyScreen{
  flex-direction:column;
  background:
    radial-gradient(ellipse 40% 30% at 10% 20%, rgba(224,92,42,0.05) 0%, transparent 60%),
    var(--bg);
  overflow:hidden;
}

.topbar{
  height:60px;flex-shrink:0;
  background:var(--bg2);border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 24px;
}
.tbar-logo{
  font-family:'Unbounded';font-size:1.1rem;font-weight:900;
  background:linear-gradient(135deg,#ff6b35,#e05c2a);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.tbar-user{display:flex;align-items:center;gap:10px;}
.tbar-avatar{
  width:34px;height:34px;border-radius:50%;
  background:linear-gradient(135deg,var(--accent),#c44b1a);
  display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:.9rem;color:#fff;
}
.tbar-name{font-weight:500;font-size:.95rem;}

.lobby-body{
  flex:1;overflow:hidden;
  display:flex;flex-direction:column;
  padding:24px;gap:20px;
}

.lobby-top{display:flex;gap:16px;flex-wrap:wrap;align-items:center;}
.lobby-title{
  font-family:'Unbounded';font-size:1.4rem;font-weight:700;
  flex:1;
}
.lobby-actions{display:flex;gap:10px;flex-wrap:wrap;}

.rooms-area{
  flex:1;overflow-y:auto;
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(320px,1fr));
  gap:14px;align-content:start;
}

.room-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius);padding:20px;cursor:pointer;
  transition:all .25s;position:relative;overflow:hidden;
}
.room-card:hover{border-color:var(--accent);transform:translateY(-3px);box-shadow:0 12px 40px rgba(0,0,0,0.4);}
.room-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--accent),var(--accent2));opacity:0;transition:opacity .25s;}
.room-card:hover::before{opacity:1;}

.rc-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;}
.rc-name{font-family:'Unbounded';font-size:.95rem;font-weight:700;}
.rc-badges{display:flex;gap:6px;flex-wrap:wrap;}
.badge{
  padding:3px 9px;border-radius:20px;
  font-size:.7rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;
}
.badge-waiting{background:rgba(234,179,8,.15);color:var(--yellow);border:1px solid rgba(234,179,8,.25);}
.badge-playing{background:rgba(239,68,68,.15);color:var(--red);border:1px solid rgba(239,68,68,.25);}
.badge-locked{background:rgba(107,114,128,.15);color:var(--muted2);border:1px solid var(--border);}
.rc-info{display:flex;gap:16px;align-items:center;color:var(--muted2);font-size:.85rem;}
.rc-players{display:flex;align-items:center;gap:6px;}
.player-dots{display:flex;gap:3px;}
.pdot{width:8px;height:8px;border-radius:50%;background:var(--border2);}
.pdot.filled{background:var(--accent);}
.rc-meta{font-size:.78rem;color:var(--muted);}

.empty-rooms{
  grid-column:1/-1;text-align:center;
  padding:60px 0;color:var(--muted);
}
.empty-rooms .emo{font-size:3rem;margin-bottom:12px;}
.empty-rooms p{font-size:1rem;}

/* ════════════════════════════════
   MODAL
════════════════════════════════ */
.overlay{
  display:none;position:fixed;inset:0;
  background:rgba(0,0,0,.8);backdrop-filter:blur(6px);
  z-index:500;align-items:center;justify-content:center;
}
.overlay.open{display:flex;}
.modal{
  background:var(--card);border:1px solid var(--border2);
  border-radius:20px;width:min(480px,95vw);
  max-height:90vh;overflow-y:auto;
  box-shadow:0 40px 100px rgba(0,0,0,.7);
  animation:modalIn .25s ease;
}
@keyframes modalIn{
  from{transform:scale(.9) translateY(30px);opacity:0;}
  to{transform:scale(1) translateY(0);opacity:1;}
}
.modal-h{
  padding:22px 24px 18px;
  border-bottom:1px solid var(--border);
  display:flex;justify-content:space-between;align-items:center;
}
.modal-h h3{font-family:'Unbounded';font-size:1rem;font-weight:700;}
.modal-close{
  width:30px;height:30px;border-radius:50%;background:var(--bg2);
  border:1px solid var(--border);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  color:var(--muted);font-size:.9rem;transition:all .2s;
}
.modal-close:hover{color:var(--red);border-color:var(--red);}
.modal-b{padding:24px;}
.modal-b .field{margin-bottom:16px;}
.modal-footer{padding:0 24px 24px;display:flex;gap:10px;justify-content:flex-end;}

/* ════════════════════════════════
   GAME SCREEN
════════════════════════════════ */
#gameScreen{
  flex-direction:column;
  background:var(--bg);
  overflow:hidden;
}

.game-topbar{
  height:56px;flex-shrink:0;
  background:var(--bg2);border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 20px;gap:12px;
}
.gtb-left{display:flex;align-items:center;gap:14px;}
.room-name-display{
  font-family:'Unbounded';font-size:.9rem;font-weight:700;
  color:var(--text);
}
.gtb-phase{
  padding:4px 12px;border-radius:20px;
  font-size:.72rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;
}
.phase-lobby{background:rgba(59,130,246,.15);color:var(--blue);}
.phase-game{background:rgba(224,92,42,.15);color:var(--accent);}
.phase-vote{background:rgba(239,68,68,.15);color:var(--red);}

.gtb-mid{
  display:flex;align-items:center;gap:10px;
  font-size:.82rem;color:var(--muted2);
}
.player-count-badge{
  padding:4px 10px;border-radius:20px;
  background:rgba(255,255,255,.06);
  font-weight:500;
}
.gtb-right{display:flex;align-items:center;gap:8px;}

/* ── GAME LAYOUT ── */
.game-body{
  flex:1;overflow:hidden;
  display:grid;
  grid-template-columns:240px 1fr 280px;
  grid-template-rows:1fr;
}

/* LEFT: Players list */
.players-panel{
  border-right:1px solid var(--border);
  background:var(--bg2);overflow-y:auto;
  display:flex;flex-direction:column;
}
.panel-title{
  padding:14px 16px 10px;
  font-family:'Unbounded';font-size:.75rem;
  font-weight:600;letter-spacing:2px;text-transform:uppercase;
  color:var(--muted);border-bottom:1px solid var(--border);
}

.player-row{
  padding:12px 14px;display:flex;align-items:center;gap:10px;
  border-bottom:1px solid var(--border);transition:background .2s;
  position:relative;cursor:default;
}
.player-row:hover{background:rgba(255,255,255,.03);}
.player-row.me{background:rgba(224,92,42,.06);}
.player-row.kicked{opacity:.35;text-decoration:line-through;}
.player-row.host-row .pname::after{content:'👑';margin-left:5px;font-size:.75rem;}

.pavatar{
  width:36px;height:36px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:.9rem;flex-shrink:0;
  border:2px solid transparent;position:relative;
}
.pavatar.speaking{
  border-color:var(--green);
  box-shadow:0 0 10px rgba(34,197,94,.5);
}
.pinfo{flex:1;min-width:0;}
.pname{font-size:.88rem;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.pstatus{font-size:.72rem;color:var(--muted);margin-top:1px;}
.p-icons{display:flex;gap:4px;align-items:center;}
.mic-icon{font-size:.8rem;opacity:.6;}
.mic-icon.muted{color:var(--red);}

.cam-mini{
  width:36px;height:27px;border-radius:5px;
  background:var(--bg);overflow:hidden;flex-shrink:0;
  border:1px solid var(--border);
}
.cam-mini video{width:100%;height:100%;object-fit:cover;}

/* CENTER: Main area */
.center-panel{
  display:flex;flex-direction:column;
  overflow:hidden;
}

/* Video grid */
.video-grid{
  flex:1;overflow:hidden;
  padding:14px;
  display:grid;gap:10px;
  align-content:start;
}
/* dynamic grid */
.video-grid.count-1{grid-template-columns:1fr;}
.video-grid.count-2{grid-template-columns:1fr 1fr;}
.video-grid.count-3,.video-grid.count-4{grid-template-columns:1fr 1fr;}
.video-grid.count-5,.video-grid.count-6{grid-template-columns:repeat(3,1fr);}
.video-grid.count-7,.video-grid.count-8{grid-template-columns:repeat(4,1fr);}

.video-tile{
  border-radius:12px;overflow:hidden;position:relative;
  background:#0c0c14;border:2px solid var(--border);
  transition:border-color .2s;aspect-ratio:16/9;
}
.video-tile.speaking-tile{border-color:var(--green);box-shadow:0 0 15px rgba(34,197,94,.3);}
.video-tile.me-tile{border-color:var(--accent);}
.video-tile video{width:100%;height:100%;object-fit:cover;display:block;}
.vtile-name{
  position:absolute;bottom:0;left:0;right:0;
  padding:18px 10px 8px;
  background:linear-gradient(transparent,rgba(0,0,0,.7));
  font-size:.78rem;font-weight:500;
}
.vtile-icons{position:absolute;top:8px;left:8px;display:flex;gap:5px;}
.vtile-icon{
  width:22px;height:22px;border-radius:5px;
  background:rgba(0,0,0,.5);
  display:flex;align-items:center;justify-content:center;font-size:.7rem;
}
.no-cam{
  position:absolute;inset:0;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:8px;
}
.no-cam-av{
  width:56px;height:56px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:1.3rem;color:#fff;
}

/* Controls bar */
.controls-bar{
  flex-shrink:0;height:70px;
  background:var(--bg2);border-top:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;gap:10px;
  padding:0 20px;
}
.ctrl-btn{
  width:46px;height:46px;border-radius:50%;
  border:2px solid var(--border2);background:var(--bg3);
  display:flex;align-items:center;justify-content:center;
  font-size:1.1rem;cursor:pointer;transition:all .2s;color:var(--text);
}
.ctrl-btn:hover{border-color:var(--muted2);background:rgba(255,255,255,.08);}
.ctrl-btn.active{border-color:var(--red);background:rgba(239,68,68,.15);}
.ctrl-sep{width:1px;height:30px;background:var(--border);margin:0 4px;}

/* RIGHT: Card + Chat */
.right-panel{
  border-left:1px solid var(--border);
  display:flex;flex-direction:column;
  background:var(--bg2);overflow:hidden;
}
.right-tabs{
  display:flex;border-bottom:1px solid var(--border);
  flex-shrink:0;
}
.rtab{
  flex:1;padding:13px 8px;border:none;background:transparent;
  color:var(--muted);cursor:pointer;font-family:'Jost';
  font-size:.8rem;font-weight:500;letter-spacing:1px;
  text-transform:uppercase;transition:all .2s;
  border-bottom:2px solid transparent;margin-bottom:-1px;
}
.rtab.active{color:var(--text);border-bottom-color:var(--accent);}
.right-content{flex:1;overflow:hidden;display:flex;flex-direction:column;}
.rpanel{display:none;flex:1;overflow:hidden;flex-direction:column;}
.rpanel.active{display:flex;}

/* ── CHARACTER CARD ── */
.card-panel{padding:16px;overflow-y:auto;gap:12px;}

.bunker-info-block{
  background:var(--bg3);border:1px solid var(--border);
  border-radius:10px;padding:14px;
}
.bib-title{
  font-size:.68rem;letter-spacing:2px;text-transform:uppercase;
  color:var(--muted);margin-bottom:8px;
}
.bib-value{font-size:.95rem;font-weight:500;color:var(--text);}
.bib-value.revealed{color:var(--accent);font-weight:600;}

.char-card{
  background:linear-gradient(145deg,var(--bg3),#1a1b26);
  border:1px solid var(--border2);border-radius:12px;
  overflow:hidden;
}
.cc-header{
  padding:14px 16px;
  background:linear-gradient(135deg,rgba(224,92,42,.15),rgba(0,0,0,0));
  border-bottom:1px solid var(--border);
  display:flex;justify-content:space-between;align-items:center;
}
.cc-header h4{
  font-family:'Unbounded';font-size:.78rem;font-weight:700;
  color:var(--accent);letter-spacing:1px;text-transform:uppercase;
}
.cc-body{padding:4px 0;}
.cc-row{
  padding:9px 16px;border-bottom:1px solid var(--border);
  display:flex;justify-content:space-between;align-items:center;gap:8px;
}
.cc-row:last-child{border-bottom:none;}
.cc-key{
  font-size:.72rem;letter-spacing:1.5px;text-transform:uppercase;
  color:var(--muted);flex-shrink:0;
}
.cc-val{
  font-size:.88rem;font-weight:500;text-align:right;
  display:flex;align-items:center;gap:6px;
}
.cc-val.hidden-val{
  color:var(--muted);font-style:italic;
}
.reveal-btn{
  padding:2px 8px;border-radius:5px;border:none;
  background:rgba(224,92,42,.2);color:var(--accent);
  font-size:.7rem;cursor:pointer;font-family:'Jost';
  font-weight:600;letter-spacing:1px;white-space:nowrap;
  transition:all .2s;
}
.reveal-btn:hover{background:rgba(224,92,42,.35);}

/* ── CHAT ── */
.chat-panel{gap:0;}
.chat-messages{
  flex:1;overflow-y:auto;padding:12px;
  display:flex;flex-direction:column;gap:8px;
}
.chat-msg{font-size:.82rem;line-height:1.5;}
.chat-msg .cm-author{font-weight:600;color:var(--accent);}
.chat-msg .cm-author.system{color:var(--muted2);font-style:italic;}
.chat-msg .cm-author.me{color:var(--blue);}
.chat-msg .cm-text{color:var(--muted2);}
.chat-msg .cm-time{font-size:.68rem;color:var(--muted);margin-left:6px;}

.chat-input-wrap{
  padding:10px 12px;border-top:1px solid var(--border);
  display:flex;gap:8px;
}
.chat-input{
  flex:1;background:var(--bg3);border:1px solid var(--border);
  border-radius:8px;padding:9px 12px;color:var(--text);
  font-family:'Jost';font-size:.85rem;outline:none;transition:border .2s;
}
.chat-input:focus{border-color:var(--accent);}
.chat-send{
  width:36px;height:36px;border-radius:8px;
  background:var(--accent);border:none;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  font-size:.9rem;color:#fff;transition:all .2s;
}
.chat-send:hover{background:var(--accent2);}

/* ── VOTE PANEL ── */
.vote-overlay{
  position:absolute;inset:0;z-index:200;
  background:rgba(0,0,0,.85);backdrop-filter:blur(4px);
  display:none;align-items:center;justify-content:center;
  flex-direction:column;gap:20px;
}
.vote-overlay.open{display:flex;}
.vote-box{
  background:var(--card);border:1px solid var(--border2);
  border-radius:20px;padding:28px;width:min(480px,92vw);
  max-height:80vh;overflow-y:auto;
}
.vote-title{
  font-family:'Unbounded';font-size:1rem;font-weight:700;
  text-align:center;margin-bottom:6px;
  background:linear-gradient(135deg,var(--red),#f97316);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.vote-subtitle{text-align:center;color:var(--muted2);font-size:.85rem;margin-bottom:22px;}
.vote-list{display:flex;flex-direction:column;gap:8px;}
.vote-player{
  padding:12px 16px;border-radius:10px;
  background:var(--bg3);border:2px solid transparent;
  cursor:pointer;transition:all .2s;
  display:flex;align-items:center;gap:12px;
}
.vote-player:hover{border-color:var(--red);background:rgba(239,68,68,.08);}
.vote-player.selected{border-color:var(--red);background:rgba(239,68,68,.15);}
.vote-player.voted-for{
  position:relative;overflow:hidden;
}
.vp-bar{
  position:absolute;left:0;top:0;bottom:0;
  background:rgba(239,68,68,.15);transition:width .5s;
}
.vp-name{font-weight:500;font-size:.9rem;position:relative;}
.vp-votes{margin-left:auto;font-size:.78rem;color:var(--muted2);position:relative;}

/* ── BUNKER INFO ── */
.bunker-sidebar{
  border-top:1px solid var(--border);
  background:rgba(0,0,0,.2);
}
.bunker-expand-btn{
  width:100%;padding:10px 16px;background:transparent;border:none;
  color:var(--muted2);cursor:pointer;font-family:'Jost';
  font-size:.75rem;letter-spacing:2px;text-transform:uppercase;
  display:flex;align-items:center;justify-content:space-between;
  transition:color .2s;
}
.bunker-expand-btn:hover{color:var(--text);}
.bunker-hidden{display:none;}
.bunker-hidden.open{display:flex;flex-direction:column;gap:8px;padding:0 12px 12px;}

/* ── GAME PHASES ── */
.phase-banner{
  padding:10px 20px;
  background:linear-gradient(135deg,rgba(224,92,42,.1),rgba(0,0,0,0));
  border-bottom:1px solid rgba(224,92,42,.15);
  display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:8px;flex-shrink:0;
}
.pb-text{font-size:.85rem;color:var(--muted2);}
.pb-text strong{color:var(--text);}

/* ── TOAST ── */
.toasts{position:fixed;top:70px;right:20px;z-index:1000;display:flex;flex-direction:column;gap:8px;pointer-events:none;}
.toast{
  padding:12px 18px;border-radius:10px;
  font-size:.85rem;font-weight:500;
  display:flex;align-items:center;gap:10px;
  animation:toastSlide .3s ease;
  pointer-events:all;min-width:220px;
  box-shadow:0 8px 25px rgba(0,0,0,.4);
}
@keyframes toastSlide{from{transform:translateX(120%);opacity:0;}to{transform:translateX(0);opacity:1;}}
.toast.success{background:#14532d;border:1px solid var(--green);color:#86efac;}
.toast.error{background:#450a0a;border:1px solid var(--red);color:#fca5a5;}
.toast.info{background:#1e3a5f;border:1px solid var(--blue);color:#93c5fd;}

/* ── LOBBY WAITING SCREEN ── */
.waiting-view{
  flex:1;display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  gap:24px;padding:30px;
  background:radial-gradient(ellipse 50% 40% at 50% 50%, rgba(224,92,42,.06) 0%, transparent 70%);
}
.waiting-room-name{
  font-family:'Unbounded';font-size:1.6rem;font-weight:900;
  text-align:center;
}
.waiting-code{
  font-family:'Unbounded';font-size:1rem;
  color:var(--accent);letter-spacing:4px;
  background:rgba(224,92,42,.1);border:1px dashed rgba(224,92,42,.4);
  padding:10px 24px;border-radius:10px;cursor:pointer;
  transition:all .2s;
}
.waiting-code:hover{background:rgba(224,92,42,.2);}
.waiting-players{
  display:flex;flex-wrap:wrap;gap:10px;justify-content:center;
  max-width:500px;
}
.wp-card{
  padding:10px 16px;background:var(--card);
  border:1px solid var(--border2);border-radius:10px;
  display:flex;align-items:center;gap:8px;font-size:.88rem;
}
.wp-card.me{border-color:var(--accent);}
.wp-host-icon{font-size:.8rem;}
.waiting-actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;}

/* ── END GAME OVERLAY ── */
.endgame-overlay{
  position:absolute;inset:0;z-index:300;
  background:rgba(0,0,0,.9);backdrop-filter:blur(8px);
  display:none;align-items:center;justify-content:center;
}
.endgame-overlay.open{display:flex;}
.endgame-box{
  text-align:center;max-width:500px;padding:40px;
  animation:modalIn .4s ease;
}
.eg-title{
  font-family:'Unbounded';font-size:2rem;font-weight:900;
  margin-bottom:10px;
}
.eg-title.survivors{
  background:linear-gradient(135deg,var(--green),#86efac);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.eg-title.dead{
  background:linear-gradient(135deg,var(--red),#f97316);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .game-body{grid-template-columns:1fr;grid-template-rows:auto 1fr auto;}
  .players-panel{display:none;}
  .right-panel{max-height:220px;}
}
@media(max-width:600px){
  .video-grid.count-3,.video-grid.count-4,.video-grid.count-5,.video-grid.count-6{grid-template-columns:1fr 1fr;}
}
</style>
</head>
