function cleanupRooms(){
  // Remove stale rooms (older than 12h)
  const now=Date.now();
  Object.keys(S.rooms).forEach(k=>{
    if(S.rooms[k].created && now-S.rooms[k].created > 12*60*60*1000) delete S.rooms[k];
    if(S.rooms[k].players && S.rooms[k].players.length===0) delete S.rooms[k];
  });
  saveRooms();
}

function refreshRooms(){
  S.rooms = JSON.parse(localStorage.getItem('bk_rooms')||'{}');
  cleanupRooms();
  renderRooms();
  toast('Обновлено','info',1500);
}

function renderRooms(){
  const area=document.getElementById('roomsArea');
  const rooms=Object.values(S.rooms).sort((a,b)=>b.created-a.created);
  if(!rooms.length){
    area.innerHTML='<div class="empty-rooms"><div class="emo">🏚️</div><p>Нет активных игр. Создай первую!</p></div>';
    return;
  }
  area.innerHTML=rooms.map(r=>{
    const dots=Array.from({length:r.maxPlayers},((_,i)=>`<div class="pdot ${i<r.players.length?'filled':''}"></div>`)).join('');
    const statusBadge = r.status==='playing'
      ? '<span class="badge badge-playing">Идёт игра</span>'
      : '<span class="badge badge-waiting">Ожидание</span>';
    const lockBadge = r.password ? '<span class="badge badge-locked">🔒</span>' : '';
    return `<div class="room-card" onclick="tryJoinRoom('${r.id}')">
      <div class="rc-top">
        <div class="rc-name">${r.name}</div>
        <div class="rc-badges">${statusBadge}${lockBadge}</div>
      </div>
      <div class="rc-info">
        <div class="rc-players"><span>${r.players.length}/${r.maxPlayers}</span><div class="player-dots">${dots}</div></div>
        <div class="rc-meta">Хост: ${r.host} · ${r.preset==='hard'?'⚔️ Хардкор':r.preset==='fun'?'😄 Веселый':'📖 Классика'}</div>
      </div>
    </div>`;
  }).join('');
}

function openCreateModal(){ openModal('createModal'); }
function openJoinModal(){ openModal('joinModal'); }

function createRoom(){
  const name=document.getElementById('cr_name').value.trim() || `Игра ${S.me}`;
  const maxPlayers=parseInt(document.getElementById('cr_players').value);
  const preset=document.getElementById('cr_preset').value;
  const password=document.getElementById('cr_pass').value.trim();
  const id=uid();
  const room={
    id, name,
    host: S.me,
    maxPlayers,
    preset,
    password: password||null,
    players:[S.me],
    status:'waiting',
    phase:'lobby',
    chat:[],
    cards:{},
    votes:{},
    revealedFields:{},
    created:Date.now(),
    catastrophe: rand(CATASTROPHES),
    bunker: rand(BUNKERS),
    kicked:[],
  };
  S.rooms[id]=room;
  saveRooms();
  closeModal('createModal');
  enterRoom(id);
}

function tryJoinRoom(id){
  S.rooms = JSON.parse(localStorage.getItem('bk_rooms')||'{}');
  const room=S.rooms[id];
  if(!room) return toast('Комната не найдена','error');
  if(room.players.includes(S.me)){enterRoom(id);return;}
  if(room.status==='playing') return toast('Игра уже началась','error');
  if(room.players.length>=room.maxPlayers) return toast('Комната заполнена','error');
  if(room.kicked && room.kicked.includes(S.me)) return toast('Вас выгнали из этой комнаты','error');
  if(room.password){
    S.pendingRoom=id;
    document.getElementById('pm_pass').value='';
    openModal('passModal');
  } else {
    joinRoom(id);
  }
}

function submitRoomPass(){
  const p=document.getElementById('pm_pass').value;
  const room=S.rooms[S.pendingRoom];
  if(!room) return;
  if(room.password!==p) return toast('Неверный пароль','error');
  closeModal('passModal');
  joinRoom(S.pendingRoom);
}

function joinByCode(){
  const code=document.getElementById('jn_code').value.trim().toUpperCase();
  S.rooms = JSON.parse(localStorage.getItem('bk_rooms')||'{}');
  const room=Object.values(S.rooms).find(r=>r.id===code);
  if(!room) return toast('Комната не найдена','error');
  closeModal('joinModal');
  tryJoinRoom(room.id);
}

function joinRoom(id){
  S.rooms = JSON.parse(localStorage.getItem('bk_rooms')||'{}');
  const room=S.rooms[id];
  if(!room) return toast('Комната не найдена','error');
  if(!room.players.includes(S.me)) room.players.push(S.me);
  saveRooms();
  enterRoom(id);
}

function enterRoom(id){
  S.currentRoom=id;
  const room=S.rooms[id];
  // Generate my card if not exists
  if(!room.cards[S.me]) {
    room.cards[S.me]=generateCard();
    saveRooms();
  }
  S.myCard=room.cards[S.me];
  showScreen('gameScreen');
  renderGameScreen();
  if(!S.localStream) requestMedia();
  startRoomSync();
}

function generateCard(){
  return {
    gender: rand(GENDERS),
    age: AGES(),
    size: rand(SIZES),
    profession: rand(PROFESSIONS),
    hobby: rand(HOBBIES),
    health: rand(HEALTH),
    trait: rand(TRAITS),
    phobia: rand(PHOBIAS),
    extra: rand(EXTRAS),
  };
}

// ════════════════════════════════════════════════
// ROOM SYNC (localStorage polling for local play)
// ════════════════════════════════════════════════
let syncInterval=null;
function startRoomSync(){
  clearInterval(syncInterval);
  syncInterval=setInterval(()=>{
    S.rooms=JSON.parse(localStorage.getItem('bk_rooms')||'{}');
    const room=S.rooms[S.currentRoom];
    if(!room){leaveRoom(true);return;}
    // Check if I was kicked
    if(room.kicked && room.kicked.includes(S.me)){
      clearInterval(syncInterval);
      toast('Вас выгнали из бункера!','error',4000);
      leaveRoom(true);
      return;
    }
    renderGameScreen();
  },1500);
}

function leaveCurrentRoom(silent){
  clearInterval(syncInterval);
  if(S.currentRoom && S.rooms[S.currentRoom]){
    const room=S.rooms[S.currentRoom];
    room.players=room.players.filter(p=>p!==S.me);
    if(room.players.length===0){delete S.rooms[S.currentRoom];}
    else if(room.host===S.me && room.players.length>0){room.host=room.players[0];}
    saveRooms();
  }
  S.currentRoom=null;
  stopMedia();
}

function leaveRoom(silent){
  leaveCurrentRoom(silent);
  showScreen('lobbyScreen');
  refreshRooms();
  if(!silent) toast('Вы покинули комнату','info');
}

